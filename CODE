        for f in ff: self.lista_plikow.append(f); self.lb.insert(tk.END, os.path.basename(f))

    def run(self):
        try:
            mx, mn = max(self.range_start.get(), self.range_end.get()), min(self.range_start.get(),
                                                                            self.range_end.get())
        except:
            return

        if not self.lista_plikow: return
        folder = os.path.dirname(self.lista_plikow[0])
        pliki_ex = [f for f in self.lista_plikow if
                    os.path.exists(os.path.join(folder, f"{self.prefiks_pliku.get()}{os.path.basename(f)}"))]
        decyzja = None
        if pliki_ex:
            decyzja = messagebox.askyesnocancel("Konflikt", "Nadpisać?")
            if decyzja is None: return

        self.ax.clear()
        for f in self.lista_plikow:
            df = wczytaj_widmo_df(f)
            if df is None: continue
            cut = df[(df['x'] <= mx) & (df['x'] >= mn)]
            if cut.empty: continue
            self.ax.plot(cut['x'], cut['y'], label=os.path.basename(f))

            sciezka_out = os.path.join(folder, f"{self.prefiks_pliku.get()}{os.path.basename(f)}")
            if os.path.exists(sciezka_out) and decyzja is False: continue

            # ZMIANA: decimal='.', sep=';'
            cut.to_csv(sciezka_out, sep=';', decimal='.', index=False, header=False, float_format='%.6f')

        self.ax.set_xlim(mx, mn);
        self.ax.legend();
        self.canvas.draw()


