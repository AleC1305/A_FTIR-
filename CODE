                                    minspanx=5, minspany=5, spancoords='pixels', interactive=False,
                                    props=dict(facecolor='blue', edgecolor='black', alpha=0.2, fill=True))
        self.canvas.mpl_connect('button_press_event', self.on_right_click_reset)

    def on_zoom_select(self, eclick, erelease):
        if eclick.xdata is None or erelease.xdata is None: return
        self.ax.set_xlim(max(eclick.xdata, erelease.xdata), min(eclick.xdata, erelease.xdata))
        self.ax.set_ylim(min(eclick.ydata, erelease.ydata), max(eclick.ydata, erelease.ydata))
        self.canvas.draw()

    def on_right_click_reset(self, event):
        if event.button == 3:
            self.ax.autoscale(enable=True, axis='both')
            left, right = self.ax.get_xlim()
            if left < right:
                self.ax.set_xlim(right, left)
            self.canvas.draw()

    def wybierz_pliki(self):
        sciezki = filedialog.askopenfilenames(title="Wybierz widma do podglądu")
        if not sciezki:
            return

        for sciezka in sciezki:
            if sciezka not in self.spectra_data:
                df = wczytaj_widmo_df(sciezka)
                if df is not None:
                    self.spectra_data[sciezka] = df
                    self.listbox.insert(tk.END, os.path.basename(sciezka))
                else:
                    messagebox.showwarning("Błąd wczytywania",
                                           f"Nie udało się wczytać pliku:\n{os.path.basename(sciezka)}")

        if self.spectra_data:
            self.update_plot()

    def update_plot(self):
        self.ax.clear()
        self.ax.set_xlabel("Liczba falowa ($cm^{-1}$)")
        self.ax.set_ylabel("Absorbancja / Transmisja")
        self.ax.grid(True, linestyle=':', alpha=0.6)

        colors = plt.cm.viridis(np.linspace(0, 1, len(self.spectra_data)))

        for i, (sciezka, df) in enumerate(self.spectra_data.items()):
            self.ax.plot(df['x'], df['y'], label=os.path.basename(sciezka), color=colors[i], linewidth=1.0)

        self.ax.invert_xaxis()
        if len(self.spectra_data) > 0:
            self.ax.set_title(f"Załadowano {len(self.spectra_data)} widm")
            if len(self.spectra_data) <= 15:
                self.ax.legend(loc='upper right', frameon=True, fontsize=8)
        else:
            self.ax.set_title("Wybierz pliki do wyświetlenia", color='gray')

        self.canvas.draw()

    def wyczysc_wszystko(self):
        self.spectra_data.clear()
        self.listbox.delete(0, tk.END)
        self.update_plot()


