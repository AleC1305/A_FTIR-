        self.fig.patch.set_facecolor('#F0F0F0')
        self.ax.set_title("Wczytaj pliki i kliknij 'Porównaj'", color='gray')
        self.ax.set_xlabel("Liczba falowa ($cm^{-1}$)")
        self.ax.grid(True, linestyle='--', alpha=0.5)
        self.canvas = FigureCanvasTkAgg(self.fig, master=parent_frame)
        self.canvas.draw()
        self.toolbar = NavigationToolbar2Tk(self.canvas, parent_frame)
        self.toolbar.update()
        self.canvas.get_tk_widget().pack(side=tk.TOP, fill=tk.BOTH, expand=True)

        self.rs = RectangleSelector(self.ax, self.on_zoom_select, useblit=True, button=[1],
                                    minspanx=5, minspany=5, spancoords='pixels', interactive=False,
                                    props=dict(facecolor='blue', edgecolor='black', alpha=0.2, fill=True))
        self.canvas.mpl_connect('button_press_event', self.on_right_click_reset)

    def on_zoom_select(self, eclick, erelease):
        if eclick.xdata is None or erelease.xdata is None: return
        self.ax.set_xlim(max(eclick.xdata, erelease.xdata), min(eclick.xdata, erelease.xdata))
        self.ax.set_ylim(min(eclick.ydata, erelease.ydata), max(eclick.ydata, erelease.ydata))
        if hasattr(self, 'ax2'):
            y2_min, y2_max = self.ax2.get_ylim()
            y1_min_new, y1_max_new = self.ax.get_ylim()
            y1_min_orig, y1_max_orig = self.ax.get_ybound()
            ratio = (y1_max_new - y1_min_new) / (y1_max_orig - y1_min_orig)
            self.ax2.set_ylim(y2_min, y2_min + (y2_max - y2_min) * ratio)
        self.canvas.draw()

    def on_right_click_reset(self, event):
        if event.button == 3:
            self.ax.autoscale(enable=True, axis='both')
            if hasattr(self, 'ax2'):
                self.ax2.autoscale(enable=True, axis='both')
            left, right = self.ax.get_xlim()
            if left < right:
                self.ax.set_xlim(right, left)
            self.canvas.draw()

    def add_molar_files(self):
        files = filedialog.askopenfilenames(title="Wybierz widma molowe")
        if files:
            for f in files:
                self.molar_files.append(f)
                self.molar_listbox.insert(tk.END, os.path.basename(f))

    def add_normal_files(self):
        files = filedialog.askopenfilenames(title="Wybierz widma normalne (surowe)")
        if files:
            for f in files:
                self.normal_files.append(f)
                self.normal_listbox.insert(tk.END, os.path.basename(f))

    def clear_lists(self):
        self.molar_files.clear()
        self.normal_files.clear()
        self.molar_listbox.delete(0, tk.END)
        self.normal_listbox.delete(0, tk.END)
        self.ax.clear()
        if hasattr(self, 'ax2'):
            self.ax2.remove()
            delattr(self, 'ax2')
        self.ax.set_title("Wczytaj pliki i kliknij 'Porównaj'", color='gray')
        self.canvas.draw()

    def run_comparison(self):
        if not self.molar_files or not self.normal_files:
            messagebox.showerror("Brak danych", "Musisz wczytać pliki do obu list.")
            return
        if len(self.molar_files) != len(self.normal_files):
            messagebox.showerror("Niezgodność", "Liczba plików w obu listach musi być taka sama.")
            return

        self.ax.clear()
        if hasattr(self, 'ax2'):
            self.ax2.remove()
            delattr(self, 'ax2')

        self.ax2 = self.ax.twinx()
        colors = plt.cm.viridis(np.linspace(0, 1, len(self.molar_files)))

        self.ax.set_xlabel("Liczba falowa ($cm^{-1}$)")
        self.ax.set_ylabel("Absorbancja Molowa", color='blue')
        self.ax2.set_ylabel("Absorbancja", color='red')
        self.ax.tick_params(axis='y', labelcolor='blue')
        self.ax2.tick_params(axis='y', labelcolor='red')

        for i, (molar_path, normal_path) in enumerate(zip(self.molar_files, self.normal_files)):
            df_molar = wczytaj_widmo_df(molar_path)
            df_normal = wczytaj_widmo_df(normal_path)

            if df_molar is None or df_normal is None:
                continue

            label = os.path.basename(normal_path)
            self.ax.plot(df_molar['x'], df_molar['y'], label=f"{label} (molowe)", color=colors[i], linewidth=1.2)
            self.ax2.plot(df_normal['x'], df_normal['y'], label=f"{label} (normalne)", color=colors[i], linestyle='--',
                          alpha=0.7)

        self.ax.invert_xaxis()
        lines, labels = self.ax.get_legend_handles_labels()
        lines2, labels2 = self.ax2.get_legend_handles_labels()
        self.ax.legend(lines + lines2, labels + labels2, loc='upper right', frameon=True, fontsize=8)
        self.fig.tight_layout()
        self.canvas.draw()


