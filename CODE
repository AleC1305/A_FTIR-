        self.res_text.delete(1.0, tk.END)
        self.res_text.insert(tk.END, "Gotowy. Kliknij prawym przyciskiem na pik.\n")

    def on_click_identify(self, event):
        if event.button != 3 or event.inaxes != self.ax: return
        x_click = event.xdata
        if x_click is None: return

        [l.remove() for l in self.ax.lines if l.get_label() == 'marker']
        self.ax.axvline(x=x_click, color='red', linestyle='--', alpha=0.8, label='marker')
        self.canvas.draw()

        znalezione = []
        for (high, low, opis) in BAZA_PASM_IR:
            mx, mn = max(high, low), min(high, low)
            if mn <= x_click <= mx:
                znalezione.append(f"• {opis}\n  (Zakres: {int(mx)}-{int(mn)} cm-1)")

        self.res_text.delete(1.0, tk.END)
        header = f"--- KLIKNIĘTO: {x_click:.1f} cm-1 ---\n\n"
        self.res_text.insert(tk.END, header, 'bold')

        if znalezione:
            self.res_text.insert(tk.END, "Możliwe przypisania:\n", 'underline')
            for z in znalezione:
                self.res_text.insert(tk.END, z + "\n")
        else:
            self.res_text.insert(tk.END, "Brak dopasowań w prostej bazie.\nTo może być obszar 'fingerprint' lub szum.")


