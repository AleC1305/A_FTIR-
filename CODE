class AnalizatorWidmApp:
    def __init__(self, root, on_close_callback=None):
        self.root = root
        self.on_close_callback = on_close_callback
        self.root.title("Korektor Widm FTIR - Moduł WOW")
        try:
            self.root.state('zoomed')
        except:
            self.root.geometry("1400x900")
        self.root.protocol("WM_DELETE_WINDOW", self.close_window)

        self.sciezka_wody = tk.StringVar()
        self.lista_plikow_probek = []
        self.prefiks_pliku = tk.StringVar(value="CORR_")
        self.entries_stezenia = {}
        self.style = ttk.Style(self.root)
        self.style.theme_use('clam')
        self.stezenie_wody_czystej = GESTOSC_WODY / MASA_MOLOWA_H2O

        self.setup_main_layout()

    def log(self, wiadomosc):
        self.log_text.insert(tk.END, wiadomosc + "\n")
        self.log_text.see(tk.END)

    def setup_main_layout(self):
        self.main_pane = ttk.PanedWindow(self.root, orient=tk.HORIZONTAL)
        self.main_pane.pack(fill=tk.BOTH, expand=True, padx=5, pady=5)

        self.left_panel = ttk.Frame(self.main_pane)
        self.left_panel.pack_propagate(False)
        self.left_panel.config(width=300)
        self.main_pane.add(self.left_panel, weight=0)

        self.right_panel = ttk.Frame(self.main_pane, relief="sunken", borderwidth=1)
        self.main_pane.add(self.right_panel, weight=1)

        self.create_control_widgets(self.left_panel)
        self.create_plot_area(self.right_panel)

    def create_plot_area(self, parent_frame):
        self.fig, self.ax = plt.subplots(figsize=(5, 4), dpi=110)
        self.fig.patch.set_facecolor('#F0F0F0')
        self.ax.set_title("Oczekiwanie na dane...", color='gray', fontsize=8)
        self.ax.set_xlabel("Liczba falowa ($cm^{-1}$)", fontsize=7)
        self.ax.set_ylabel("Absorbancja", fontsize=7)
        self.ax.tick_params(axis='both', labelsize=6)
        self.ax.grid(True, linestyle='--', alpha=0.5, linewidth=0.5)
        self.canvas = FigureCanvasTkAgg(self.fig, master=parent_frame)
        self.canvas.draw()
        self.toolbar = NavigationToolbar2Tk(self.canvas, parent_frame)
        self.toolbar.update()
        self.canvas.get_tk_widget().pack(side=tk.TOP, fill=tk.BOTH, expand=True)
        self.rs = RectangleSelector(self.ax, self.on_zoom_select, useblit=True, button=[1],
                                    minspanx=5, minspany=5, spancoords='pixels', interactive=False,
                                    props=dict(facecolor='blue', edgecolor='black', alpha=0.2, fill=True))
        self.canvas.mpl_connect('button_press_event', self.on_right_click_reset)

    def on_zoom_select(self, eclick, erelease):
        if eclick.xdata is None or erelease.xdata is None: return
        self.ax.set_xlim(max(eclick.xdata, erelease.xdata), min(eclick.xdata, erelease.xdata))
        self.ax.set_ylim(min(eclick.ydata, erelease.ydata), max(eclick.ydata, erelease.ydata))
        self.canvas.draw()

    def on_right_click_reset(self, event):
        if event.button == 3:
            self.ax.autoscale(enable=True, axis='both')
            l, r = self.ax.get_xlim()
            if l < r: self.ax.set_xlim(r, l)
            self.canvas.draw()

    def update_plot_multi(self, datasets):
        self.ax.clear()
        colors = ['#1f77b4', '#ff7f0e', '#2ca02c', '#d62728', '#9467bd', '#8c564b']
        for i, data in enumerate(datasets):
            color = colors[i % len(colors)]
            self.ax.plot(data['x'], data['raw'], color='gray', alpha=0.35, linewidth=0.8, zorder=1)
            self.ax.plot(data['x'], data['water'], color='blue', alpha=0.4, linewidth=0.8, linestyle='--', zorder=2)
            self.ax.plot(data['x'], data['corr'], label=data['name'], color=color, alpha=0.9, linewidth=1.0, zorder=3)
        self.ax.invert_xaxis()
        self.ax.legend(loc='upper right', frameon=True, fontsize=8)
        self.ax.grid(True, linestyle=':', alpha=0.6)
        self.rs = RectangleSelector(self.ax, self.on_zoom_select, useblit=True, button=[1],
                                    minspanx=5, minspany=5, spancoords='pixels', interactive=False,
                                    props=dict(facecolor='blue', edgecolor='black', alpha=0.2, fill=True))
        self.canvas.draw()

    def wybierz_wode(self):
        sciezka = filedialog.askopenfilename(title="Wybierz widmo wody")
        if sciezka: self.sciezka_wody.set(sciezka)

    def wybierz_pliki_probek(self):
        sciezki = filedialog.askopenfilenames(title="Wybierz próbki")
        if sciezki:
            for sciezka in sciezki:
                if sciezka not in self.lista_plikow_probek:
                    self.lista_plikow_probek.append(sciezka)
                    self.dodaj_wiersz_probki(sciezka)

    def dodaj_wiersz_probki(self, sciezka):
        row = ttk.Frame(self.scroll_inner)
        row.pack(fill="x", pady=2)
        ttk.Label(row, text=os.path.basename(sciezka), width=20, anchor="w", wraplength=150).pack(side="left", padx=2,
                                                                                                  fill='x', expand=True)
        entry = ttk.Entry(row, width=10)
        entry.pack(side="left", padx=2)
        entry.insert(0, f"{self.stezenie_wody_czystej:.2f}")
        self.entries_stezenia[sciezka] = entry

    def create_control_widgets(self, parent):
        ttk.Button(parent, text="⬅ Wróć do Menu Głównego", command=self.close_window).pack(fill="x", padx=5, pady=5)
        top = ttk.LabelFrame(parent, text="1. Konfiguracja", padding=3)
        top.pack(fill="x", padx=3, pady=3)
        ttk.Entry(top, textvariable=self.sciezka_wody).grid(row=0, column=0, sticky="ew")
        top.grid_columnconfigure(0, weight=1)
        ttk.Button(top, text="Woda...", command=self.wybierz_wode).grid(row=0, column=1)
        ttk.Button(top, text="➕ Próbki", command=self.wybierz_pliki_probek).grid(row=1, column=0, columnspan=2,
                                                                                 sticky="ew")
        mid = ttk.LabelFrame(parent, text="2. Stężenia", padding=3)
        mid.pack(fill="both", expand=True, padx=3, pady=3)
        cv = tk.Canvas(mid);
        sb = ttk.Scrollbar(mid, command=cv.yview)
        self.scroll_inner = ttk.Frame(cv);
        cv.create_window((0, 0), window=self.scroll_inner, anchor="nw")
        cv.configure(yscrollcommand=sb.set);
        self.scroll_inner.bind("<Configure>", lambda e: cv.configure(scrollregion=cv.bbox("all")))
        cv.pack(side="left", fill="both", expand=True);
        sb.pack(side="right", fill="y")
        bot = ttk.LabelFrame(parent, text="3. Akcja", padding=3)
        bot.pack(fill="x", padx=3, pady=3)
        ttk.Entry(bot, textvariable=self.prefiks_pliku, width=6).pack(side="left")
        ttk.Button(bot, text="START", command=self.uruchom_przetwarzanie).pack(side="right")
        self.log_text = scrolledtext.ScrolledText(parent, height=8);
        self.log_text.pack(fill="both", padx=3, pady=3, expand=True)

    def close_window(self):
        self.root.destroy()
        if self.on_close_callback: self.on_close_callback()

    def uruchom_przetwarzanie(self):
        # 1. Sprawdzenie czy wybrano wodę i próbki
        if not self.sciezka_wody.get() or not self.lista_plikow_probek:
            return

        # 2. Wczytanie wzorca (wody)
        df_woda = wczytaj_widmo_df(self.sciezka_wody.get())
        if df_woda is None:
            messagebox.showerror("Błąd", "Nie udało się wczytać widma wody.")
            return

        y_woda = df_woda['y'].values
        x_woda = df_woda['x'].values
        len_woda = len(x_woda)
        range_woda = (min(x_woda), max(x_woda))  # tuple (min, max)

        # 3. FAZA WERYFIKACJI (Pre-scan)
        konflikty = []

        # Iterujemy po wszystkich próbkach, które mają wpisane stężenie (czyli są aktywne)
        aktywne_sciezki = [s for s, ent in self.entries_stezenia.items() if ent.get()]

        for sciezka in aktywne_sciezki:
            nazwa_pliku = os.path.basename(sciezka)
            df_temp = wczytaj_widmo_df(sciezka)

            if df_temp is None:
                konflikty.append(f"• {nazwa_pliku}: Błąd odczytu pliku")
                continue

            x_temp = df_temp['x'].values
            len_temp = len(x_temp)
            range_temp = (min(x_temp), max(x_temp))

            # A. Sprawdzenie liczby punktów
            if len_temp != len_woda:
                konflikty.append(f"• {nazwa_pliku}: Różna liczba punktów!\n    Woda: {len_woda}, Próbka: {len_temp}")
                continue  # Jeśli długość inna, nie sprawdzamy zakresu bo i tak nie pasuje

            # B. Sprawdzenie zakresów (z tolerancją np. 1.0 cm-1 na przesunięcia maszynowe)
            diff_min = abs(range_temp[0] - range_woda[0])
            diff_max = abs(range_temp[1] - range_woda[1])

            if diff_min > 1.0 or diff_max > 1.0:
                konflikty.append(
                    f"• {nazwa_pliku}: Inny zakres widma!\n"
                    f"    Woda: {range_woda[1]:.1f}-{range_woda[0]:.1f}\n"
                    f"    Próbka: {range_temp[1]:.1f}-{range_temp[0]:.1f}"
                )

        # Jeśli znaleziono jakiekolwiek problemy, przerwij i pokaż raport
        if konflikty:
            raport = "\n".join(konflikty[:10])  # Pokaż max 10 błędów, żeby okno nie było za duże
            if len(konflikty) > 10:
                raport += f"\n... i {len(konflikty) - 10} innych."

            messagebox.showerror("Niezgodność Widm",
                                 f"Nie można wykonać odejmowania. Wykryto różnice w wymiarach lub zakresach:\n\n{raport}\n\n"
                                 "Wymagane jest, aby widmo wody i próbki miały tę samą rozdzielczość i zakres.")
            return

        # ==========================================================
        # 4. WŁAŚCIWE PRZETWARZANIE (Skoro przeszliśmy weryfikację)
        # ==========================================================

        pliki_do_nadpisania = []
        folder_zapisu = os.path.dirname(self.lista_plikow_probek[0])
        for sciezka in aktywne_sciezki:
            nazwa = f"{self.prefiks_pliku.get()}{os.path.basename(sciezka)}"
            if os.path.exists(os.path.join(folder_zapisu, nazwa)): pliki_do_nadpisania.append(nazwa)

        decyzja = None
        if pliki_do_nadpisania:
            decyzja = messagebox.askyesnocancel("Konflikt", "Pliki wyjściowe istnieją. Nadpisać?")
            if decyzja is None: return

        plots = []
        processed_count = 0

        for s, ent in self.entries_stezenia.items():
            try:
                c = float(ent.get().replace(',', '.'))
            except:
                continue

            df = wczytaj_widmo_df(s)  # Wczytujemy ponownie (bezpieczniej niż trzymać w RAM przy dużej ilości)
            if df is None: continue

            # Tutaj już wiemy, że wymiary są identyczne
            # Wykonujemy proste odejmowanie wektorowe
            res = df['y'].values - (y_woda * (c / self.stezenie_wody_czystej))

            plots.append({
                'name': os.path.basename(s),
                'x': df['x'].values,
                'raw': df['y'].values,
                'water': y_woda * (c / self.stezenie_wody_czystej),
                'corr': res
            })

            sciezka_out = os.path.join(os.path.dirname(s), f"{self.prefiks_pliku.get()}{os.path.basename(s)}")
            if os.path.exists(sciezka_out) and decyzja is False: continue

            # Eksport w formacie uniwersalnym (kropka)
            pd.DataFrame({0: df['x'].values, 1: res}).to_csv(
                sciezka_out, sep=';', decimal='.', index=False, header=False, float_format='%.6f'
            )
            processed_count += 1

        self.update_plot_multi(plots)
        self.log(f"Zakończono pomyślnie dla {processed_count} plików.")


