    def add_dashboard_button(self, parent, title, desc, command, row, col):
        """Pomocnicza funkcja do tworzenia kafelków menu"""
        frame = ttk.Frame(parent, padding=10)
        frame.grid(row=row, column=col, sticky="nsew", padx=15, pady=5)

        btn = ttk.Button(frame, text=title, style="Card.TButton", command=command)
        btn.pack(fill="x")

        lbl = ttk.Label(frame, text=desc, style="Sub.TLabel")
        lbl.pack(pady=(5, 0))

        parent.grid_columnconfigure(col, weight=1)

    def open_module(self, app_class):
        """Ukrywa menu i otwiera wybrany moduł"""
        self.root.withdraw()
        new_window = tk.Toplevel(self.root)
        app_class(new_window, on_close_callback=lambda: self.root.deiconify())

    def uruchom_wow(self): self.open_module(AnalizatorWidmApp)

    def uruchom_cut(self): self.open_module(WidmoCutterApp)

    def uruchom_base(self): self.open_module(BaselineCorrectionApp)

    def uruchom_ident(self): self.open_module(BandIdentApp)

    def uruchom_smol(self): self.open_module(MolarCalcApp)

    def uruchom_view(self): self.open_module(SpectrumViewerApp)

    def uruchom_comp(self): self.open_module(SpectrumComparerApp)


