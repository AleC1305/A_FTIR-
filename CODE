def wczytaj_widmo_df(sciezka):
    df = None
    try:
        # Detekcja nagłówka (czy pierwsza linia zawiera litery)
        with open(sciezka, 'r', encoding='utf-8-sig') as f:
            pierwsza_linia = f.readline()
            ma_naglowek = any(c.isalpha() for c in pierwsza_linia)
        header_arg = 0 if ma_naglowek else None

        # --- PRÓBA 1: Format "Polski" (sep=';', decimal=',') ---
        # To jest priorytet, o który prosiłeś.
        try:
            df_attempt = pd.read_csv(sciezka, sep=';', decimal=',', header=header_arg,
                                     engine='python', encoding='utf-8-sig',
                                     on_bad_lines='skip', skipinitialspace=True)

            # Dodatkowe zabezpieczenie: Jeśli mimo decimal=',' wczytało jako obiekt (tekst),
            # wykonaj ręczną konwersję (zamiana , na . i rzutowanie na float).
            if len(df_attempt.columns) >= 2:
                cols_to_check = df_attempt.columns[:2]
                for col in cols_to_check:
                    if df_attempt[col].dtype == 'object':
                        # Zamień przecinki na kropki w stringach i skonwertuj
                        df_attempt[col] = (df_attempt[col].astype(str)
                                           .str.replace(',', '.', regex=False)
                                           .str.replace(r'[^\d.-]', '', regex=True))  # usuń ewentualne śmieci
                        df_attempt[col] = pd.to_numeric(df_attempt[col], errors='coerce')

                # Sprawdź czy po naprawie pierwsza kolumna jest numeryczna
                valid_vals = df_attempt.iloc[:, 0].dropna()
                if not valid_vals.empty and pd.api.types.is_numeric_dtype(valid_vals):
                    df = df_attempt
        except Exception:
            pass

        # --- PRÓBA 2: Format "Międzynarodowy" (sep=',', decimal='.') ---
        if df is None:
            try:
                df_attempt = pd.read_csv(sciezka, sep=',', decimal='.', header=header_arg,
                                         engine='python', encoding='utf-8-sig',
                                         on_bad_lines='skip', skipinitialspace=True)
                if len(df_attempt.columns) >= 2 and pd.api.types.is_numeric_dtype(df_attempt.iloc[:, 0].dropna()):
                    df = df_attempt
            except Exception:
                pass

        # --- PRÓBA 3: Format "Spacja/Tabulacja" (sep=\s+, decimal='.') ---
        if df is None:
            try:
                df_attempt = pd.read_csv(sciezka, sep=r'\s+', decimal='.', header=header_arg,
                                         engine='python', encoding='utf-8-sig',
                                         on_bad_lines='skip', skipinitialspace=True)
                if len(df_attempt.columns) >= 2 and pd.api.types.is_numeric_dtype(df_attempt.iloc[:, 0].dropna()):
                    df = df_attempt
            except Exception:
                pass

        if df is None: return None

        # Ostateczne czyszczenie danych
        df = df.iloc[:, [0, 1]]
        df.columns = ['x', 'y']

        # Upewnij się, że mamy floaty (kropki wewnątrz systemu)
        df['x'] = pd.to_numeric(df['x'], errors='coerce')
        df['y'] = pd.to_numeric(df['y'], errors='coerce')
        df.dropna(inplace=True)

        return df if not df.empty else None

    except Exception:
        return None


