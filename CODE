    def wybierz_pliki(self):
        sciezki = filedialog.askopenfilenames(title="Wybierz widma do przeliczenia")
        if sciezki:
            for sciezka in sciezki:
                if sciezka not in self.lista_plikow:
                    self.lista_plikow.append(sciezka)
                    self.dodaj_wiersz_probki(sciezka)
            self.log(f"Dodano {len(sciezki)} plików.")

    def dodaj_wiersz_probki(self, sciezka):
        row_frame = ttk.LabelFrame(self.scroll_inner, text=os.path.basename(sciezka))
        row_frame.pack(fill="x", pady=3, padx=3)

        inputs_frame = ttk.Frame(row_frame)
        inputs_frame.pack(fill='x', pady=2)

        inputs_frame.columnconfigure(1, weight=1)
        inputs_frame.columnconfigure(3, weight=1)

        ttk.Label(inputs_frame, text="Masa [g]:").grid(row=0, column=0, sticky='w')
        mass_entry = ttk.Entry(inputs_frame, width=8)
        mass_entry.grid(row=0, column=1, sticky='ew', padx=2)

        ttk.Label(inputs_frame, text="Gęstość [g/mL]:").grid(row=0, column=2, sticky='w', padx=(5, 0))
        density_entry = ttk.Entry(inputs_frame, width=8)
        density_entry.grid(row=0, column=3, sticky='ew', padx=2)

        result_label = ttk.Label(row_frame, text="Wynik: -", foreground="blue")
        result_label.pack(fill='x', pady=2, padx=5)

        self.probki_widgets[sciezka] = {
            'mass_entry': mass_entry,
            'density_entry': density_entry,
            'result_label': result_label
        }

    def update_plot(self, datasets):
        self.ax.clear()
        self.ax.set_xlabel("Liczba falowa ($cm^{-1}$)")
        self.ax.set_ylabel("Absorbancja Molowa")
        self.ax.grid(True, linestyle=':', alpha=0.6)
        colors = plt.cm.viridis(np.linspace(0, 1, len(datasets)))

        for i, data in enumerate(datasets):
            self.ax.plot(data['x'], data['y_molar'], label=data['name'], color=colors[i], linewidth=1.0)

        self.ax.invert_xaxis()
        self.ax.legend(loc='upper right', frameon=True, fontsize=8)
        self.canvas.draw()

    def uruchom_przeliczanie(self):
        if not self.lista_plikow:
            messagebox.showwarning("Brak plików", "Najpierw dodaj pliki widm.")
            return

        try:
            masa_molowa = self.masa_molowa_var.get()
            if masa_molowa <= 0:
                messagebox.showerror("Błąd danych", "Masa molowa musi być liczbą dodatnią.")
                return
        except tk.TclError:
            messagebox.showerror("Błąd danych", "Wprowadź prawidłową wartość masy molowej.")
            return

        folder_zapisu = os.path.dirname(self.lista_plikow[0])
        prefiks = self.prefiks_pliku.get()
        pliki_do_nadpisania = [os.path.basename(s) for s in self.lista_plikow if
                               os.path.exists(os.path.join(folder_zapisu, f"{prefiks}{os.path.basename(s)}"))]

        decyzja = None
        if pliki_do_nadpisania:
            decyzja = messagebox.askyesnocancel("Konflikt",
                                                f"Pliki o nazwach\n{', '.join(pliki_do_nadpisania)}\njuż istnieją. Czy chcesz je nadpisać?")
            if decyzja is None:
                self.log("Anulowano.")
                return

        self.log("Rozpoczynam przeliczanie...")
        plots_data = []
        processed_count = 0

        for sciezka in self.lista_plikow:
            try:
                widgets = self.probki_widgets[sciezka]
                masa = float(widgets['mass_entry'].get().replace(',', '.'))
                gestosc = float(widgets['density_entry'].get().replace(',', '.'))

                liczba_moli = masa / masa_molowa

                if gestosc == 0:
                    self.log(f"BŁĄD: Gęstość dla {os.path.basename(sciezka)} nie może być zerem!")
                    widgets['result_label'].config(text="Błąd: gęstość = 0", foreground="red")
                    continue

                objetosc_ml = masa / gestosc
                objetosc_l = objetosc_ml / 1000.0
                stezenie = liczba_moli / objetosc_l

                df = wczytaj_widmo_df(sciezka)
                if df is None:
                    self.log(f"BŁĄD: Nie można wczytać pliku {os.path.basename(sciezka)}")
                    continue

                if stezenie == 0:
                    self.log(f"BŁĄD: Obliczone stężenie dla {os.path.basename(sciezka)} wynosi zero!")
                    widgets['result_label'].config(text="Błąd: stężenie = 0", foreground="red")
                    continue

                y_molar = df['y'] / stezenie

                sciezka_zapisu = os.path.join(folder_zapisu, f"{prefiks}{os.path.basename(sciezka)}")
                if os.path.exists(sciezka_zapisu) and decyzja is False:
                    self.log(f"Pominięto zapis: {os.path.basename(sciezka)}")
                    continue

                # ZMIANA: decimal='.', sep=';'
                pd.DataFrame({'x': df['x'], 'y_molar': y_molar}).to_csv(
                    sciezka_zapisu, index=False, header=False, sep=';', decimal='.', float_format='%.6f'
                )

                widgets['result_label'].config(text=f"n={liczba_moli:.4f} mol, C={stezenie:.4f} M", foreground="green")
                plots_data.append({'name': os.path.basename(sciezka), 'x': df['x'], 'y_molar': y_molar})
                self.log(f"OK: {os.path.basename(sciezka)}")
                processed_count += 1

            except ValueError:
                self.log(f"BŁĄD: Nieprawidłowe dane (masa/gęstość) dla {os.path.basename(sciezka)}")
                self.probki_widgets[sciezka]['result_label'].config(text="Błąd: nieprawidłowe dane", foreground="red")
            except ZeroDivisionError:
                self.log(f"BŁĄD: Dzielenie przez zero dla {os.path.basename(sciezka)}. Sprawdź masę molową i gęstość.")
                self.probki_widgets[sciezka]['result_label'].config(text="Błąd: Dzielenie przez zero", foreground="red")
            except Exception as e:
                self.log(f"Nieznany błąd dla {os.path.basename(sciezka)}: {e}")
                self.probki_widgets[sciezka]['result_label'].config(text="Błąd", foreground="red")

        if plots_data:
            self.update_plot(plots_data)

        messagebox.showinfo("Gotowe", f"Pomyślnie przetworzono i zapisano {processed_count} plików.")


