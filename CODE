    def uruchom_korekte(self):
        if not self.lista_plikow: return
        try:
            lam, p = self.param_lambda.get(), self.param_p.get()
        except ValueError:
            return

        folder_zapisu = os.path.dirname(self.lista_plikow[0])
        prefiks = self.prefiks_pliku.get()

        pliki_do_nadpisania = []
        for sciezka in self.lista_plikow:
            if os.path.exists(os.path.join(folder_zapisu, f"{prefiks}{os.path.basename(sciezka)}")):
                pliki_do_nadpisania.append(os.path.basename(sciezka))

        decyzja = None
        if pliki_do_nadpisania:
            decyzja = messagebox.askyesnocancel("Konflikt", "Pliki istnieją. Nadpisać?")
            if decyzja is None: return

        self.ax.clear()
        processed_count = 0
        for i, sciezka in enumerate(self.lista_plikow):
            df = wczytaj_widmo_df(sciezka)
            if df is None: continue
            y = df['y'].values
            baseline = baseline_als(y, lam, p)
            y_corr = y - baseline

            label = "Skorygowane" if i == 0 else ""
            self.ax.plot(df['x'], y, color='gray', alpha=0.3, linewidth=0.8)
            self.ax.plot(df['x'], y_corr, alpha=0.9, linewidth=1.0, label=label)

            sciezka_zapisu = os.path.join(folder_zapisu, f"{prefiks}{os.path.basename(sciezka)}")
            if os.path.exists(sciezka_zapisu) and decyzja is False: continue

            # ZMIANA: decimal='.', sep=';'
            pd.DataFrame({0: df['x'], 1: y_corr}).to_csv(
                sciezka_zapisu, index=False, header=False, sep=';', decimal='.', float_format='%.6f'
            )
            processed_count += 1
            self.log(f"OK: {os.path.basename(sciezka)}")

        self.ax.invert_xaxis()
        self.canvas.draw()
        messagebox.showinfo("Gotowe", f"Przetworzono {processed_count} plików.")

