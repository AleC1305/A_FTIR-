            messagebox.showerror("Błąd", "Nie udało się wczytać pliku.")
            return

        self.current_spectrum = df
        self.current_filename = os.path.basename(sciezka)
        self.lbl_plik.config(text=self.current_filename, foreground="black")

        self.ax.clear()
        self.ax.plot(df['x'], df['y'], color='#2c3e50', linewidth=1.0)
        self.ax.set_title(f"Widmo: {self.current_filename}")
        self.ax.set_xlabel("Liczba falowa ($cm^{-1}$)")
        self.ax.grid(True, linestyle=':', alpha=0.6)

        self.ax.set_xlim(max(df['x']), min(df['x']))

